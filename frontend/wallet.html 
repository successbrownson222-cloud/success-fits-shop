<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SuccessPay - My Wallet</title>
<style>
body{font-family:Arial;padding:15px;background:#f5f5f5}
.card{background:white;padding:20px;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,0.1);margin-bottom:15px}
.bal{font-size:32px;font-weight:bold;color:#111}
.acct{background:#eef6ff;padding:12px;border-radius:8px;font-family:monospace;font-size:18px;margin:10px 0}
.btn{width:100%;padding:14px;border:none;border-radius:8px;font-size:16px;font-weight:bold;cursor:pointer;margin-top:10px}
.btn-blue{background:#0a58ca;color:white}
.btn-black{background:#111;color:white}
.btn-green{background:#0a8a42;color:white}
input{width:100%;padding:12px;margin:8px 0;border:1px solid #ddd;border-radius:8px;font-size:16px;box-sizing:border-box}
.small{color:#666;font-size:13px}
</style>
</head>
<body>

<div class="card">
<h2>💳 SuccessPay Wallet</h2>
<p class="small" id="userEmail">Loading...</p>
<h1 class="bal" id="balance">₦0.00</h1>
<p class="small">Wallet Balance</p>

<div class="acct">
<span id="vAccount">---- ----</span><br>
<small id="bankName">SUCCESS PAY MFB</small>
</div>
<p class="small">Transfer to this account from any bank app to fund your wallet. It will auto-credit.</p>
<button class="btn btn-blue" onclick="loadWallet()">🔄 Refresh Balance</button>
</div>

<div class="card" id="createBox" style="display:none">
<h3>Create Wallet</h3>
<input id="pin1" type="password" placeholder="Create 4-digit PIN (e.g 1234)">
<button class="btn btn-black" onclick="createWallet()">Create My Wallet</button>
</div>

<div class="card">
<h3>Pay Order with Wallet</h3>
<input id="orderId" type="number" placeholder="Order ID (e.g 12)">
<input id="amount" type="number" placeholder="Amount in Kobo (e.g 500000 = ₦5000)">
<input id="pinPay" type="password" placeholder="Enter Wallet PIN">
<button class="btn btn-green" onclick="payOrder()">Pay Now</button>
<p id="payMsg" class="small"></p>
</div>

<script>
const API = window.location.origin; // same domain
let email = localStorage.getItem('sf_email') || localStorage.getItem('email') || '';
if(!email){
  email = prompt("Enter your email to load wallet:");
  if(email) localStorage.setItem('sf_email', email);
}
document.getElementById('userEmail').innerText = email;

async function loadWallet(){
  if(!email){ alert("No email"); return; }
  try{
    let res = await fetch(`${API}/api/payments/wallet/${email}`);
    let data = await res.json();
    if(res.ok){
      document.getElementById('balance').innerText = `₦${(data.balance/100).toLocaleString()}`;
      document.getElementById('vAccount').innerText = data.virtual_account;
      document.getElementById('createBox').style.display='none';
    } else {
      // wallet not found
      document.getElementById('createBox').style.display='block';
      document.getElementById('vAccount').innerText = 'No wallet yet';
    }
  }catch(e){
    alert("Error: "+e.message);
  }
}

async function createWallet(){
  let pin = document.getElementById('pin1').value;
  if(pin.length < 4){ alert("PIN must be 4 digits"); return; }
  try{
    let res = await fetch(`${API}/api/payments/create-wallet`, {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({email: email, pin: pin})
    });
    let data = await res.json();
    if(data.ok){
      alert("Wallet created! Account: "+data.virtual_account);
      loadWallet();
    } else {
      alert("Failed: "+JSON.stringify(data));
    }
  }catch(e){ alert(e.message); }
}

async function payOrder(){
  let oid = document.getElementById('orderId').value;
  let amt = document.getElementById('amount').value;
  let pin = document.getElementById('pinPay').value;
  if(!oid || !amt || !pin){ alert("Fill all"); return; }
  document.getElementById('payMsg').innerText = "Processing...";
  try{
    let res = await fetch(`${API}/api/payments/pay-order`, {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({email: email, order_id: parseInt(oid), amount: parseInt(amt), pin: pin})
    });
    let data = await res.json();
    if(data.ok){
      document.getElementById('payMsg').innerText = "✅ Paid! Ref: "+data.ref+" New Bal: ₦"+(data.new_balance/100);
      loadWallet();
    } else {
      document.getElementById('payMsg').innerText = "❌ "+(data.error || data.detail || "Failed");
    }
  }catch(e){ document.getElementById('payMsg').innerText = e.message; }
}

// auto load
loadWallet();

// copy account on click
document.getElementById('vAccount').onclick = function(){
  let txt = this.innerText;
  navigator.clipboard.writeText(txt).then(()=>alert("Copied: "+txt));
}
</script>
</body>
</html>