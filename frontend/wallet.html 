<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SuccessPay Wallet</title>
<style>
body{font-family:Arial;padding:15px;background:#070707;color:#fff}
.card{background:#111;border:1px solid #222;padding:20px;border-radius:16px;margin-bottom:15px}
.bal{font-size:34px;font-weight:900;color:#0aff7a}
.acct{background:#1a2a1a;padding:14px;border-radius:10px;font-family:monospace;font-size:20px;margin:10px 0;color:#0aff7a;border:1px dashed #0aff7a}
.btn{width:100%;padding:14px;border:none;border-radius:12px;font-size:16px;font-weight:900;cursor:pointer;margin-top:10px}
.btn-blue{background:#0aff7a;color:#000}
.btn-black{background:#fff;color:#000}
.btn-green{background:#0aff7a;color:#000}
input{width:100%;padding:14px;margin:8px 0;background:#1e1e1e;border:1px solid #2a2a2a;color:#fff;border-radius:10px;font-size:16px;box-sizing:border-box}
.small{color:#888;font-size:13px}
</style>
</head>
<body>

<div class="card">
<h2>💳 SuccessPay Wallet</h2>
<p class="small" id="userEmail">Loading...</p>
<h1 class="bal" id="balance">₦0.00</h1>
<p class="small">Wallet Balance</p>
<div class="acct"><span id="vAccount">----</span><br><small style="font-size:11px;color:#fff">SUCCESS PAY MFB</small></div>
<p class="small">Tap account to copy. Transfer from any bank app to fund.</p>
<button class="btn btn-blue" onclick="loadWallet()">🔄 Refresh</button>
</div>

<div class="card" id="createBox" style="display:none">
<h3>Create Wallet</h3>
<input id="pin1" type="password" placeholder="Create 4-digit PIN (e.g 1234)">
<button class="btn btn-black" onclick="createWallet()">Create My Wallet</button>
</div>

<div class="card">
<h3>Test Funding (Phone Mode)</h3>
<p class="small">No Postman needed. Click to credit yourself ₦5000 for testing checkout.</p>
<button onclick="testFund()" style="background:#333;color:#fff;padding:12px;border:none;border-radius:10px;width:100%;margin-top:10px;font-weight:800">🧪 TEST FUND ₦5000</button>
<button onclick="testFund10000()" style="background:#222;color:#0aff7a;padding:12px;border:1px solid #0aff7a;border-radius:10px;width:100%;margin-top:8px;font-weight:800">🧪 TEST FUND ₦10000</button>
<p id="fundMsg" class="small" style="margin-top:10px"></p>
</div>

<div class="card">
<a href="/" style="color:#ff2d55;text-decoration:none">← Back to Shop</a>
</div>

<script>
const API = window.location.origin;
let email = localStorage.getItem('sf_email') || localStorage.getItem('email') || localStorage.getItem('userEmail') || '';
if(!email){
  email = prompt("Enter your email to load wallet:");
  if(email) localStorage.setItem('sf_email', email);
}
document.getElementById('userEmail').innerText = email || "Guest";

async function loadWallet(){
  if(!email){ alert("No email"); return; }
  try{
    let res = await fetch(`${API}/api/payments/wallet/${encodeURIComponent(email)}`);
    let data = await res.json();
    if(res.ok && data.ok){
      document.getElementById('balance').innerText = `₦${(data.balance/100).toLocaleString()}`;
      document.getElementById('vAccount').innerText = data.virtual_account;
      document.getElementById('createBox').style.display='none';
    } else {
      document.getElementById('createBox').style.display='block';
      document.getElementById('vAccount').innerText = 'No wallet yet';
      document.getElementById('balance').innerText = '₦0.00';
    }
  }catch(e){ alert(e.message); }
}

async function createWallet(){
  let pin = document.getElementById('pin1').value;
  if(pin.length < 4){ alert("PIN 4 digits"); return; }
  try{
    let res = await fetch(`${API}/api/payments/create-wallet`, {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({email: email, pin: pin})
    });
    let data = await res.json();
    if(data.ok){ alert("Wallet created! "+data.virtual_account); loadWallet(); }
    else alert(JSON.stringify(data));
  }catch(e){ alert(e.message); }
}

async function testFund(){
  let acct = document.getElementById('vAccount').innerText.trim();
  if(!acct || acct.includes('No wallet') || acct.includes('--') || acct.length < 8){ alert("Create wallet first"); return; }
  document.getElementById('fundMsg').innerText = "Funding...";
  try{
    let res = await fetch(`${API}/api/payments/webhook/bank`, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({account_number: acct, amount: 5000, transaction_ref: 'TEST'+Date.now()})
    });
    let data = await res.json();
    document.getElementById('fundMsg').innerText = JSON.stringify(data);
    if(data.ok) loadWallet();
  }catch(e){ document.getElementById('fundMsg').innerText = e.message; }
}

async function testFund10000(){
  let acct = document.getElementById('vAccount').innerText.trim();
  if(!acct || acct.includes('No wallet') || acct.includes('--') || acct.length < 8){ alert("Create wallet first"); return; }
  document.getElementById('fundMsg').innerText = "Funding ₦10000...";
  try{
    let res = await fetch(`${API}/api/payments/webhook/bank`, {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({account_number: acct, amount: 10000, transaction_ref: 'TEST'+Date.now()})
    });
    let data = await res.json();
    document.getElementById('fundMsg').innerText = JSON.stringify(data);
    if(data.ok) loadWallet();
  }catch(e){ document.getElementById('fundMsg').innerText = e.message; }
}

loadWallet();
document.getElementById('vAccount').onclick = function(){
  let txt = this.innerText.trim();
  if(txt.length > 5){ navigator.clipboard.writeText(txt).then(()=>alert("Copied: "+txt)); }
}
</script>
</body>
</html>